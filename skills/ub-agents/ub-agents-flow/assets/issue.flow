flow v0
# OWNER/NAME, issue phase: from a new issue to ready.

columns main stop

end created col=main tone=muted "Issue created"
pill needs-preparation tone=muted
decision g1 tone=system "G1 Launcher: may it start?"
box issue-preparer "states behavior and acceptance criteria"
decision g2 tone=system "G2 Clear and in scope?"
pill ready tone=done
end delivery "Implementation picks it up"

panel human col=stop row=g2 tone=stop
  pill needs-human
  strong "G3 A maintainer answers"
  muted "answers on the issue,"
  muted "removes needs-human"

created --> needs-preparation : a maintainer adds the label
needs-preparation --> g1
g1 --> issue-preparer : yes, before every run
issue-preparer --> g2
g2 --> ready : prepared
ready --> delivery
g2 --> human tone=stop : needs-human: unclear intent or a scope change
human --> needs-preparation tone=stop from=top to=right label=end : re-adds needs-preparation

legend
  decision tone=system "gate, numbered as in the cards"
  pill tone=done "GitHub label"
  panel tone=stop "a person decides"

play "Prepared"
  step created
  step needs-preparation actor="A maintainer" "Adds the label"
  step g1 "Nothing holds it"
  step issue-preparer actor="issue-preparer" "Writes the behavior and acceptance criteria"
  step g2 "Yes: prepared"
  step ready
  step delivery

play "A maintainer answers"
  step g2 "No: the intent is unclear"
  step human 2.4s actor="A maintainer" "Answers on the issue, removes needs-human"
  step needs-preparation
  step g1
  step issue-preparer actor="issue-preparer" "Prepares it with the answer"
  step g2 "Yes: prepared"
  step ready
  step delivery
