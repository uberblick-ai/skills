flow v0
# uberblick-ai/ub-agents, issue phase: from a new issue to ready.

columns main stop

pill needs-preparation col=main tone=muted
decision g1 tone=system "G1 Launcher: may it start?"
box issue-preparer "states behavior and acceptance criteria"
decision g2 tone=system "G2 Clear and in scope?"
pill ready tone=done
end delivery "Implementation picks it up"

panel human col=stop row=g2 tone=stop
  pill needs-human
  strong "G6 A maintainer decides"
  muted "answers on the issue,"
  muted "removes needs-human"

needs-preparation --> g1
g1 --> issue-preparer : yes, before every run
issue-preparer --> g2
g2 --> ready : prepared
ready --> delivery
g2 --> human tone=stop : needs-human
human --> needs-preparation tone=stop from=top to=right label=end : re-adds needs-preparation

legend
  decision tone=system "gate, numbered as in the cards"
  pill tone=done "GitHub label"
  panel tone=stop "a person decides"
