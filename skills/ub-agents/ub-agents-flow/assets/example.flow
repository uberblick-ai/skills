flow v0
# uberblick-ai/ub-agents: four agents carry an issue from preparation to merge.

columns rework main stop

pill needs-preparation col=main tone=muted
decision g1 tone=system "G1 Launcher: may it start?"
box issue-preparer "states behavior and acceptance criteria"
decision g2 tone=system "G2 Clear and in scope?"
pill ready tone=done
box implementer "branch, code, checks, draft PR"
decision g3 tone=system "G3 Checks green, PR ready?"
pill needs-review tone=agent
box reviewer "different model, exact head commit"
decision g4 tone=system "G4 Criteria met?"
pill ready-to-merge tone=done
box integrator "base merge, final checks"
decision g5 tone=system "G5 Green Test on head, policy?"
end merged "Squash-merged, issue closed"

pill needs-changes col=rework row=g4 tone=rework

panel human col=stop row=g2 span=7 tone=stop
  pill needs-human
  strong "G6 A maintainer decides"
  muted "answers or merges,"
  muted "removes needs-human,"
  muted "re-adds the trigger"

needs-preparation --> g1
g1 --> issue-preparer : yes, before every run
issue-preparer --> g2
g2 --> ready : prepared
ready --> implementer
implementer --> g3
g3 --> needs-review : handed-off
needs-review --> reviewer
reviewer --> g4
g4 --> ready-to-merge : approved
ready-to-merge --> integrator
integrator --> g5
g5 --> merged : merged

g4 --> needs-changes tone=rework : changes-requested
g5 --> needs-changes tone=rework to=bottom : changes-requested
needs-changes --> implementer tone=rework from=top to=left label=end : revise the same PR

g2 --> human tone=stop : needs-human
g5 --> human tone=stop : maintainer-merge

legend
  decision tone=system "gate, numbered as on page 2"
  pill tone=done "GitHub label"
  panel tone=stop "a person decides"
