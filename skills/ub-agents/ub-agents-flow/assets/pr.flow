flow v0
# OWNER/NAME, implementation and PR phase: from ready to merged.

columns rework main stop

pill ready col=main tone=done "ready (issue)"
decision g1 tone=system "G1 Launcher: may it start?"
box implementer "branch, code, checks, draft PR"
decision g3 tone=system "G2 Checks green, PR ready?"
pill needs-review tone=agent
box reviewer "different model, exact head commit"
decision g4 tone=system "G3 Criteria met?"
pill ready-to-merge tone=done
box integrator "base merge, final checks"
decision g5 tone=system "G4 Final checks pass, policy allows?"
end merged "Merged, issue closed"

pill needs-changes col=rework row=g4 tone=rework

panel human col=stop row=g5 tone=stop
  pill needs-human
  strong "G5 A maintainer merges"
  muted "changes the policy reserves"
  muted "for a person"

ready --> g1
g1 --> implementer : yes, before every run
implementer --> g3
g3 --> needs-review : handed-off
needs-review --> reviewer
reviewer --> g4
g4 --> ready-to-merge : approved
ready-to-merge --> integrator
integrator --> g5
g5 --> merged : merged

g4 --> needs-changes tone=rework : changes-requested
g5 --> needs-changes tone=rework to=bottom : changes-requested
needs-changes --> implementer tone=rework from=top to=left label=end : revise the same PR

g5 --> human tone=stop : maintainer-merge: a guarded path

legend
  decision tone=system "gate, numbered as in the cards"
  pill tone=done "GitHub label"
  panel tone=stop "a person decides"

play "Clean run"
  step ready
  step g1 "Nothing holds it"
  step implementer actor="implementer" "Builds the change, runs the checks, opens a draft PR"
  step g3 "Yes: handed off for review"
  step needs-review
  step reviewer actor="reviewer" "Reviews the exact head on another model"
  step g4 "Yes: approved"
  step ready-to-merge
  step integrator actor="integrator" "Merges the base in, reruns the final checks"
  step g5 "Yes: the integrator merges"
  step merged

play "A maintainer merges"
  step integrator actor="integrator" "The final checks pass"
  step g5 "No: it touches a guarded path"
  step human 2.4s actor="A maintainer" "Reviews and merges it"

play "One review round"
  step needs-review
  step reviewer actor="reviewer" "Reviews the exact head"
  step g4 "No: a criterion is not met"
  step needs-changes
  step implementer actor="implementer" "Revises the same PR"
  step g3 "Yes: handed off again"
  step needs-review
  step reviewer actor="reviewer" "Reviews the new head"
  step g4 "Yes: approved"
  step ready-to-merge
  step integrator actor="integrator"
  step g5
  step merged
